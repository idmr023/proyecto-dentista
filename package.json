{
  "name": "dentista-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Sistema integral de gestión odontológica",
  "scripts": {
    "dev": "concurrently \"npm run dev:front\" \"npm run dev:back\"",
    "dev:front": "cd front && npm run dev",
    "dev:back": "cd back && npm run dev",
    "build": "cd front && npm run build && cd ../back && npm run build",
    "build:front": "cd front && npm run build",
    "build:back": "cd back && npm run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
